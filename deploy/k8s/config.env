BASE_URL=https://privnet.kizy.ch
# Public UDP endpoint clients dial: the external IP of Service privnet-wg.
# deploy/deploy.sh fills this in automatically from the LoadBalancer status.
WG_ENDPOINT=83.228.201.62:51820
WG_PORT=51820
WG_POOL=10.77.0.0/16
WG_MTU=1380
WG_KEEPALIVE=25
SIGNUP_MODE=open
MAX_NETWORKS_PER_USER=3
SHARE_TTL=72h
# Private-IP DNS (nip.io-style) with ACME DNS-01. Empty DNS_ZONE disables it.
# Delegate DNS_ZONE to DNS_NAMESERVER, whose A record must be DNS_PUBLIC_IP
# (the external IP of Service privnet-dns, filled in by deploy/deploy.sh).
DNS_ZONE=ip.kizy.ch
DNS_NAMESERVER=privnet-ns.kizy.ch
DNS_PUBLIC_IP=179.237.118.172
DNS_LISTEN=:5353
MAX_DNS_ZONES_PER_USER=3
MAX_DNS_RECORDS_PER_ZONE=64
